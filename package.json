{
  "name": "isodraw",
  "version": "0.1.0",
  "description": "React component for drawing Cloudcraft-style architecture diagrams in flat (2D) and isometric (2.5D) views.",
  "type": "module",
  "main": "./dist/isodraw.cjs",
  "module": "./dist/isodraw.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/isodraw.js",
      "require": "./dist/isodraw.cjs"
    },
    "./style.css": "./dist/isodraw.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config vite.lib.config.ts",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "npm run typecheck && npm test && npm run build:demo && gh-pages -d demo-dist -m \"Deploy demo\""
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^3.2.7"
  },
  "homepage": "https://sjostrom.io/isodraw/",
  "dependencies": {
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-list": "3.32.1",
    "@tiptap/extension-mention": "3.32.1",
    "@tiptap/extension-table": "3.32.1",
    "@tiptap/extensions": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "@tiptap/suggestion": "3.32.1",
    "tiptap-markdown": "0.9.0"
  },
  "overrides": {
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-blockquote": "3.32.1",
    "@tiptap/extension-bold": "3.32.1",
    "@tiptap/extension-bubble-menu": "3.32.1",
    "@tiptap/extension-bullet-list": "3.32.1",
    "@tiptap/extension-code": "3.32.1",
    "@tiptap/extension-code-block": "3.32.1",
    "@tiptap/extension-document": "3.32.1",
    "@tiptap/extension-dropcursor": "3.32.1",
    "@tiptap/extension-floating-menu": "3.32.1",
    "@tiptap/extension-gapcursor": "3.32.1",
    "@tiptap/extension-hard-break": "3.32.1",
    "@tiptap/extension-heading": "3.32.1",
    "@tiptap/extension-horizontal-rule": "3.32.1",
    "@tiptap/extension-italic": "3.32.1",
    "@tiptap/extension-link": "3.32.1",
    "@tiptap/extension-list": "3.32.1",
    "@tiptap/extension-list-item": "3.32.1",
    "@tiptap/extension-list-keymap": "3.32.1",
    "@tiptap/extension-mention": "3.32.1",
    "@tiptap/extension-ordered-list": "3.32.1",
    "@tiptap/extension-paragraph": "3.32.1",
    "@tiptap/extension-strike": "3.32.1",
    "@tiptap/extension-table": "3.32.1",
    "@tiptap/extension-text": "3.32.1",
    "@tiptap/extension-underline": "3.32.1",
    "@tiptap/extensions": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "@tiptap/suggestion": "3.32.1"
  }
}
