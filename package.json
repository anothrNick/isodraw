{
  "name": "isodraw",
  "version": "0.1.0",
  "description": "React component for drawing Cloudcraft-style architecture diagrams in flat (2D) and isometric (2.5D) views.",
  "type": "module",
  "main": "./dist/isodraw.umd.cjs",
  "module": "./dist/isodraw.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/isodraw.js",
      "require": "./dist/isodraw.umd.cjs"
    },
    "./style.css": "./dist/isodraw.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config vite.lib.config.ts",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0"
  }
}
