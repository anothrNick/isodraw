{
  "name": "isodraw-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:preview && tsc -p tsconfig.json --noEmit && vite build",
    "build:preview": "esbuild preview/render.ts --bundle --format=esm --platform=browser --conditions=workerd,worker --target=es2022 --minify --define:process.env.NODE_ENV='\"production\"' --outfile=functions-lib/preview.gen.js --log-level=warning",
    "typecheck": "npm run build:preview && tsc -p tsconfig.json --noEmit && tsc -p functions/tsconfig.json",
    "deploy": "npm run build && npx --yes wrangler@4.156.0 pages deploy",
    "preview:pages": "npm run build && npx --yes wrangler@4.156.0 pages dev --port 5190 --binding API_ORIGIN=http://localhost:8080",
    "test": "vitest run preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isodraw": "*",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
