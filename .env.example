# Local development settings (npm run dev copies this to .env the first time).
# Everything here is for the local compose services; nothing is secret.
DATABASE_URL=postgres://isodraw:isodraw@localhost:5433/isodraw?sslmode=disable
OIDC_ISSUER=http://localhost:5556/dex
OIDC_CLIENT_ID=isodraw-local
OIDC_CLIENT_SECRET=local-secret
PUBLIC_URL=http://localhost:5190
SESSION_SECRET=dev-only-not-a-secret
ADDR=:8080
