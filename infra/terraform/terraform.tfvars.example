# Copy to terraform.tfvars and fill in.
app_url = "https://isodraw.example.com"
region  = "us-east-1"

# Reuse an existing pool (one account across products), or leave empty for a new one.
# existing_user_pool_id = "us-east-1_XXXXXXXXX"

# Only used when creating a pool; must be globally unique.
# domain_prefix = "isodraw"

# Email through SES (optional): the sending domain and address. Turn on
# cognito_email_via_ses once SES has production access.
# email_domain          = "isodraw.example.com"
# email_from            = "hello@isodraw.example.com"
# cognito_email_via_ses = true
