{
  "name": "@isodraw/cli",
  "version": "0.1.0",
  "description": "Work with IsoDraw diagrams and their docs from the command line; built for people and AI agents.",
  "type": "module",
  "bin": { "isodraw": "dist/isodraw.mjs" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/isodraw.mjs --banner:js=\"#!/usr/bin/env node\" --define:__VERSION__=\\\"$npm_package_version\\\" --log-level=warning",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
