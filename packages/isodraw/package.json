{
  "name": "isodraw",
  "version": "0.1.0",
  "description": "React component for drawing Cloudcraft-style architecture diagrams in flat (2D) and isometric (2.5D) views.",
  "type": "module",
  "main": "./dist/isodraw.cjs",
  "module": "./dist/isodraw.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/isodraw.js",
      "require": "./dist/isodraw.cjs"
    },
    "./style.css": "./dist/isodraw.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config vite.lib.config.ts",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "npm run typecheck && npm test && npm run build:demo && gh-pages -d demo-dist -m \"Deploy demo\""
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^3.2.7"
  },
  "homepage": "https://sjostrom.io/isodraw/",
  "dependencies": {
    "@tiptap/core": "3.32.1",
    "@tiptap/extension-list": "3.32.1",
    "@tiptap/extension-mention": "3.32.1",
    "@tiptap/extension-table": "3.32.1",
    "@tiptap/extensions": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/react": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "@tiptap/suggestion": "3.32.1",
    "tiptap-markdown": "0.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anothrNick/isodraw.git",
    "directory": "packages/isodraw"
  }
}
